							"// Set a collection variable\r",
							"pm.collectionVariables.set(\"collectionVar\", \"collectionValue\");\r",
							"\r",
							"// Set an environment variable\r",
							"pm.environment.set(\"envVar\", \"envValue\");\r",
							"\r",
							"console.log(\"Variables have been set.\");\r",
