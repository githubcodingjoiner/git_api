		{
			"name": "Get all orders",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Check if there's an order by a specific customer name\", () => {\r",
							"    const response = pm.response.json(); // Parse the response body as JSON\r",
							"\r",
							"    // Define the customer name to search for\r",
							"    const targetCustomerName = \"John Doe\"; // Replace with the actual name you are searching for\r",
							"\r",
							"    // Use the `find` method to look for an order by the target customer name\r",
							"    const orderByCustomer = response.find(order => order.customerName === targetCustomerName);\r",
							"\r",
							"    // Log the response for debugging\r",
							"    console.log(\"Response:\", response);\r",
							"\r",
							"    // Check if an order was found\r",
							"    if (orderByCustomer) {\r",
							"        // If found, validate the customer name\r",
							"        pm.expect(orderByCustomer).to.be.an(\"object\");\r",
							"        pm.expect(orderByCustomer.customerName).to.equal(targetCustomerName);\r",
							"        console.log(\"Order found for customer:\", orderByCustomer);\r",
							"    } else {\r",
							"        // If not found, fail the test with a custom error message\r",
							"        pm.expect.fail(`No order found for customer name: ${targetCustomerName}`);\r",
							"    }\r",
							"});\r",
							""
						],
						"type": "text/javascript",
