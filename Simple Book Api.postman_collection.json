				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the response body\r",
							"let res = pm.response.json();\r",
							"\r",
							"// Debug log the entire response body\r",
							"console.log(\"Response body:\", res);\r",
							"\r",
							"// Check and store dynamic data\r",
							"if (res.clientId && res.accessToken) {\r",
							"    pm.collectionVariables.set(\"clientId\", res.clientId);\r",
							"    pm.collectionVariables.set(\"accessToken\", res.accessToken);\r",
							"\r",
							"    // Log success\r",
							"    console.log(\"Client ID:\", res.clientId);\r",
							"    console.log(\"Access Token:\", res.accessToken);\r",
							"} else {\r",
							"    console.log(\"Error: Missing clientId or accessToken in the response\");\r",
							"}\r",
							"\r",
							"// Test to validate stored variables\r",
							"pm.test(\"Verify dynamic data is stored\", () => {\r",
							"    pm.expect(pm.collectionVariables.get(\"clientId\")).to.exist;\r",
							"    pm.expect(pm.collectionVariables.get(\"accessToken\")).to.exist;\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
