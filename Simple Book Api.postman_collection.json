		{
			"name": "list of books",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the response JSON\r",
							"let res = pm.response.json();\r",
							"\r",
							"// Filter books based on availability\r",
							"let availableBooks = res.filter(book => book.available === true);\r",
							"\r",
							"// Check if there are available books\r",
							"if (availableBooks.length > 0) {\r",
							"    let selectedBook = availableBooks[0]; // Select the first available book\r",
							"    pm.collectionVariables.set(\"bookId\", selectedBook.id); // Save the bookId to a collection variable\r",
							"} else {\r",
							"    console.log(\"No available books found.\");\r",
							"}\r",
							"\r",
							"// Add a test to ensure the response has required fields\r",
							"pm.test(\"Each book has required keys\", () => {\r",
							"    res.forEach(book => {\r",
							"        pm.expect(book).to.have.property(\"id\");\r",
							"        pm.expect(book).to.have.property(\"name\");\r",
							"        pm.expect(book).to.have.property(\"available\");\r",
							"    });\r",
							"});\r",
							"// Search for data in the response body using a for loop\r",
							"pm.test(\"Search for data in the response body\", () => {\r",
							"    let res = pm.response.json();\r",
							"    let searchTerm = \"fiction\";\r",
							"    let foundBooks = [];\r",
							"\r",
							"    for (let i = 0; i < res.length; i++) {\r",
							"        if (res[i].type.toLowerCase() === searchTerm) {\r",
							"            foundBooks.push(res[i]);\r",
							"        }\r",
							"    }\r",
							"\r",
							"    if (foundBooks.length === 0) {\r",
							"        console.log(`No books found with type ${searchTerm}.`);\r",
							"    }\r",
							"});\r",
							"// Add console output to the test script\r",
							"console.log(\"Available books:\", availableBooks);\r",
							"console.log(\"Selected book ID:\", pm.collectionVariables.get(\"bookId\"));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseurl}}/books?type=fiction",
					"host": [
						"{{baseurl}}"
					],
					"path": [
						"books"
					],
					"query": [
						{
							"key": "type",
							"value": "fiction"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get a single book",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let response = pm.response.json();\r",
							"\r",
							"// Check if the response contains the 'id' property\r",
							"pm.test(\"Response contains 'id'\", function () {\r",
							"    pm.expect(response).to.have.property(\"id\");\r",
							"    console.log(\"Book ID in response:\", response.id);\r",
							"});\r",
							"\r",
							"// Test if the fetched book details match the expected book ID\r",
							"pm.test(\"Fetched specific book details\", function () {\r",
							"    const bookId = pm.environment.get(\"bookId\");\r",
							"    pm.expect(bookId).to.not.be.undefined;\r",
							"    pm.expect(response.id).to.eql(Number(bookId)); // Ensure the types match\r",
							"    console.log(\"Expected Book ID:\", bookId);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseurl}}/books/:bookId?type=non-fiction",
					"host": [
						"{{baseurl}}"
					],
					"path": [
						"books",
						":bookId"
					],
					"query": [
						{
							"key": "type",
							"value": "non-fiction"
						}
					],
					"variable": [
